module main

// A `#if` condition must be answerable at compile time. Anything else is an
// error: treating an unknown condition as false would silently drop code, which
// is far worse than refusing to build.

fun someRuntimeCall() -> bool {
    return true
}

fun main() -> i32 {
    #if someRuntimeCall() {
        return 1
    }
    return 0
}
