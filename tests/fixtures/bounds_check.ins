module main

// In-range indexing and sub-slicing must be unaffected by --bounds-check.
// Returns 42.

fun main() -> i32 {
    i32[] s = [10, 20, 12]     // sum via in-range indexing = 42
    i32 total = 0
    i64 i = 0
    while i < s.len {
        total = total + s[i]
        i = i + 1
    }

    i32[] mid = s[1..3]        // in-range sub-slice {20, 12}
    total = total + mid[0] - mid[0]   // exercises checked sub-slice indexing

    i32[3] a
    a[0] = 100
    a[2] = 0
    total = total + a[2]       // in-range fixed-array index

    return total
}
