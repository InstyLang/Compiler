module main

// for-in loops: integer ranges and iteration over fixed arrays, slices, sub-
// slices, and text, plus break / skip and nesting. Returns 42.

struct P { i32 x, i32 y }

fun main() -> i32 {
    i32 total = 0

    // Range form.
    for i in 0..5 {
        total = total + i          // 0+1+2+3+4 = 10
    }

    // Fixed array.
    i32[4] a
    a[0] = 1
    a[1] = 2
    a[2] = 3
    a[3] = 4
    for x in a {
        total = total + x          // +10  => 20
    }

    // Slice + sub-slice.
    i32[] s = [10, 20, 30, 40]
    for x in s[1..3] {
        total = total + x          // 20+30 = 50 => 70
    }

    // text (bytes).
    i32 letters = 0
    for c in "abc" {
        letters = letters + 1      // 3
    }
    total = total + letters        // => 73

    // break / skip.
    for i in 0..100 {
        if i < 5 { skip }
        if i == 8 { break }
        total = total - i          // subtract 5,6,7 = 18 => 55
    }

    // Nested range.
    i32 grid = 0
    for r in 0..3 {
        for col in 0..3 {
            grid = grid + 1        // 9
        }
    }
    total = total - grid           // 55 - 9 = 46

    // Aggregate elements (value copy: mutating the loop var must not change src).
    P[2] pts
    pts[0] = P{ x: 1, y: 1 }
    pts[1] = P{ x: 1, y: 1 }
    for p in pts {
        p.x = 100                  // discarded (copy)
    }
    total = total - pts[0].x - pts[1].x - pts[1].y - pts[0].y   // 46 - 4 = 42

    return total
}
