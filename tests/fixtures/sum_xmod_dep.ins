module sum_xmod_dep

// A tagged-union enum exported for use by another module (cross-module sum type).
export enum Expr {
    Lit(i64),
    Add(Expr*, Expr*),
    Neg(Expr*)
}

export fun mk_lit(i64 v) -> Expr* {
    Expr* e = new Expr
    unsafe { ~e = Expr.Lit(v) }
    return e
}

export fun mk_add(Expr* l, Expr* r) -> Expr* {
    Expr* e = new Expr
    unsafe { ~e = Expr.Add(l, r) }
    return e
}

// Constructed and matched in the defining module.
export fun eval(Expr* e) -> i64 {
    Expr node
    unsafe { node = ~e }
    match node {
        Lit(v) => return v
        Add(l, r) => return eval(l) + eval(r)
        Neg(x) => return 0 - eval(x)
    }
    return 0
}
