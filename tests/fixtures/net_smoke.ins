module main

import net::tcp
import net::udp
import net::http
import net::https
import net::ws
import net::wss
import net::quic

fun main() -> i32 {
    u32 loopback = tcp.ipv4(127, 0, 0, 1)

    i64 tcpFd = tcp.open()
    if tcpFd < 0 { return 10 }
    tcp.close(tcpFd)

    i64 udpFd = udp.open()
    if udpFd < 0 { return 20 }
    udp.close(udpFd)

    if loopback == 0 { return 30 }
    if https.errNotImplemented() >= 0 { return 40 }
    if ws.errNotImplemented() >= 0 { return 41 }
    if wss.errNotImplemented() >= 0 { return 42 }
    if quic.errNotImplemented() >= 0 { return 43 }

    return 0
}
