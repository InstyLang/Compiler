module main

// Sub-slicing `s[a..b]` (and the open-bound forms) produce a new { ptr, len }
// over the same backing storage. Exercises half-open, open-lower, open-upper,
// full, fixed-array, and chained sub-slices. Returns 42.

fun sum(i32[] xs) -> i32 {
    i32 total = 0
    i64 i = 0
    while i < xs.len {
        total = total + xs[i]
        i = i + 1
    }
    return total
}

fun main() -> i32 {
    i32[] s = [1, 2, 3, 4, 5, 6]

    i32 a = sum(s[1..4])       // 2+3+4   = 9
    i32 b = sum(s[3..])        // 4+5+6   = 15
    i32 c = sum(s[..2])        // 1+2     = 3
    i32 d = s[2..5][1]         // -> [3,4,5][1] = 4
    i32 e = cast<i32>(s[..].len)   // 6

    i32[6] arr
    arr[0] = 1
    arr[1] = 1
    arr[2] = 1
    arr[3] = 1
    arr[4] = 1
    arr[5] = 1
    i32 f = sum(arr[0..5])     // 5

    return a + b + c + d + e + f   // 9+15+3+4+6+5 = 42
}
