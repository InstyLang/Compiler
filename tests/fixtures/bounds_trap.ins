module main

// A runtime out-of-range index must trap under --bounds-check. `i` is computed in
// a loop so it is not constant-folded to a compile-time-known index.

fun main() -> i32 {
    i32[] s = [1, 2, 3]
    i64 i = 0
    while i < 10 {
        i = i + 1              // i == 10 at runtime (>= s.len)
    }
    return s[i]               // out of bounds -> ud2 trap
}
