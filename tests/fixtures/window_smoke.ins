module main

import std::window.{Window, WindowEvent, Dim}

fun onEvent(WindowEvent e) -> void {
    switch e {
        Close => return
        KeyDown(code) => return
        Resize(w, h) => return
        _ => return
    }
}

fun main() -> i32 {
    // Struct literal constructor.
    Dim d = Dim{w: 800, h: 600}
    if d.w != 800 { return 1 }

    // Closed window lifecycle is harmless.
    Window w = Window()
    if w.isValid() { return 2 }
    w.close()
    w.setTitle("no crash")

    // Register handler via function pointer.
    unsafe { w.on(cast<u64>(&onEvent)) }

    // Unit variants work.
    WindowEvent c = WindowEvent.Close
    WindowEvent p = WindowEvent.Paint
    switch c {
        Close => {}
        _ => {}
    }

    // Payload variant construction now works cross-module.
    WindowEvent k = WindowEvent.KeyDown(65)
    WindowEvent r = WindowEvent.Resize(1024, 768)

    w.blockExit()

    return 0
}
