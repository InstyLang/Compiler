module main

import std::window

fun onEvent(window.WindowEvent e) -> void {
    switch e {
        Close => return
        KeyDown(code) => return
        Resize(w, h) => return
        _ => return
    }
}

fun main() -> i32 {
    // Struct literal — works.
    window.Dim d = Dim{w: 800, h: 600}
    if d.w != 800 { return 1 }

    // Closed window lifecycle is harmless.
    window.Window w = Window()
    if w.isValid() { return 2 }
    w.close()
    w.setTitle("no crash")

    // Register handler via function pointer.
    unsafe { w.on(cast<u64>(&onEvent)) }

    // Unit variants cross module boundaries.
    window.WindowEvent c = window.Close
    window.WindowEvent p = window.Paint
    switch c {
        Close => {}
        _ => {}
    }

    w.blockExit()

    return 0
}
