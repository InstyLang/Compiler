module main

// A by-value call result that is a class with a destructor is destroyed exactly
// once, in every disposition:
//   - bound to a local / returned / assigned: constructed directly into the
//     destination (elision), so no husk is leaked or double-destroyed,
//   - discarded, used as a subexpression (f().field), or passed as an argument:
//     the result temporary is destroyed at the end of the statement
//     (previously these all leaked).
// A live-magic guard detects any double destruction of the same object.

i32 dtors = 0
i32 doubleFree = 0

class Res {
    i32 v
    i32 live

    constructor(i32 x) {
        this.v = x
        this.live = 12345
    }

    destructor() -> void {
        if (this.live == 12345) {
            dtors = dtors + 1
            this.live = 0
        } else {
            doubleFree = doubleFree + 1
        }
    }
}

fun make(i32 x) -> Res {
    return Res(x)           // RVO: constructed into the caller's storage
}

fun forward(i32 x) -> Res {
    return make(x)          // RVO through a call chain
}

fun take(Res r) -> i32 {
    return r.v
}

fun boundForms() -> i32 {
    Res a = make(1)         // bound -> elide (one object)
    Res b = forward(2)      // RVO through chain (one object)
    Res c = Res(3)
    c = make(4)             // assignment -> elide the new value
    return a.v + b.v + c.v  // 1 + 2 + 4 = 7
    // a, b, c each destroyed once at scope exit -> dtors += 3
}

fun discardForms() -> i32 {
    make(5)                 // discarded bare statement -> destroyed once
    i32 f = make(6).v       // field of a discarded result -> destroyed once
    i32 t = take(make(7))   // call result as an argument -> destroyed once
    return f + t            // 6 + 7 = 13
    // three discarded results each destroyed once -> dtors += 3
}

fun main() -> i32 {
    i32 s1 = boundForms()   // dtors += 3
    i32 s2 = discardForms() // dtors += 3
    // s1 = 7, s2 = 13 ; dtors = 6 ; doubleFree = 0
    // 7 + 13 + 6 + doubleFree*100 = 26
    return s1 + s2 + dtors + doubleFree * 100
}
