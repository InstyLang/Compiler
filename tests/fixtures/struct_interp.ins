module main

// Exercises custom-backend struct/class string interpolation:
//   - auto-derived struct format  ->  "Point { x: 3, y: 9 }"
//   - class with toString method  ->  "Named#custom"
//   - nested struct field         ->  recursive aggregate formatting
// Reads bytes back out of the interpolated buffers to assert the formatting
// ran, returning a fixed success code. Freestanding-safe (stack buffers).

struct Point {
    i32 x
    i32 y
}

struct Line {
    Point a
    i32 len
}

class Named {
    i32 id
    constructor(i32 i) {
        this.id = i
    }
    fun toString() -> text {
        return "Named#custom"
    }
}

fun main() -> i32 {
    Point p = Point{ x: 3, y: 9 }
    text sp = "$p"
    // "Point { x: 3, y: 9 }"
    //  0:'P'(80) 8:'x'(120) 11:'3'(51)

    Named nm = Named(5)
    text sn = "$nm"
    // "Named#custom" -> [0]='N'(78), [5]='#'(35)

    Line ln = Line{ a: Point{ x: 1, y: 2 }, len: 7 }
    text sl = "$ln"
    // "Line { a: Point { x: 1, y: 2 }, len: 7 }" -> [0]='L'(76)

    unsafe {
        i32 acc = 0
        if cast<i32>(sp[0]) == 80 { acc = acc + 1 }    // 'P'
        if cast<i32>(sp[8]) == 120 { acc = acc + 1 }   // 'x'
        if cast<i32>(sp[11]) == 51 { acc = acc + 1 }   // '3'
        if cast<i32>(sn[0]) == 78 { acc = acc + 1 }    // 'N'
        if cast<i32>(sn[5]) == 35 { acc = acc + 1 }    // '#'
        if cast<i32>(sl[0]) == 76 { acc = acc + 1 }    // 'L'
        return acc                                      // expect 6
    }
}
