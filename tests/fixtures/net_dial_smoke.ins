module main

import net::dial
import std::io

fun main() -> i32 {
    // --- parseIpv4 ---
    u32 loopback = dial.parseIpv4("127.0.0.1")
    if loopback == 0 { io.eprintln("parseIpv4 failed"); return 1 }
    u32 bad = dial.parseIpv4("not.an.ip")
    if bad != 0 { io.eprintln("parseIpv4 should return 0 for garbage"); return 2 }

    // --- tcpConnect (fails gracefully — no listener on 127.0.0.1:9) ---
    dial.TcpStream conn = dial.tcpConnect("127.0.0.1", 9)
    if conn.isOpen() {
        io.eprintln("unexpected: connected to discard port");
        conn.close()
        return 3
    }

    // --- tcpListen ---
    dial.TcpListener srv = dial.tcpListen("127.0.0.1", 0)
    if !srv.isOpen() { io.eprintln("tcpListen failed"); return 4 }
    srv.close()

    // --- UdpSocket ---
    dial.UdpSocket sock = dial.udpBind("127.0.0.1", 0)
    if !sock.isOpen() { io.eprintln("udpBind failed"); return 5 }
    sock.close()

    // --- string read/write helpers (no peer, just construct + call) ---
    dial.TcpStream s = TcpStream(-1, "")
    String out = s.readAll()
    if out.len() != 0 { return 6 }
    s.close()

    // --- ipv4 convenience ---
    u32 lb2 = dial.ipv4("127.0.0.1")
    if lb2 == 0 { return 7 }

    return 0
}
