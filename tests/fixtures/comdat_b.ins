module comdat_b

import std::vec

// The same Vector<i64> instantiation as `comdat_a`. Separately compiled, both
// objects define every method of it; the object writer has to mark those
// definitions so the linker folds them instead of reporting duplicates.
export fun sum_b(i64 n) -> i64 {
    Vector<i64> v = Vector<i64>()
    i64 i = 0
    while i < n {
        v.push(i * 2)
        i = i + 1
    }
    i64 total = 0
    i = 0
    while i < v.len() {
        total = total + v.get(i)
        i = i + 1
    }
    return total
}
