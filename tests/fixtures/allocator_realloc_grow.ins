module main

fun main() -> i32 {
    unsafe {
        u8* p = @malloc(16, 16)
        if cast<u64>(p) == 0 {
            return 2
        }
        p[0] = 11
        p[15] = 31

        u8* q = @realloc(p, 16, 32, 16)
        if cast<u64>(q) == 0 {
            return 3
        }
        q[16] = 7
        i32 total = cast<i32>(q[0]) + cast<i32>(q[15]) + cast<i32>(q[16])
        @free(q, 32, 16)
        return total
    }
}
