module main

i32 destroyed = 0

class Token {
    i32 value

    constructor(i32 v) {
        this.value = v
    }

    destructor() -> void {
        destroyed = destroyed + this.value
    }
}

fun main() -> i32 {
    i32 i = 0
    while i < 5 {
        Token* p = new Token(7)
        delete p
        i = i + 1
    }

    Token* arr = new Token[3](9)
    delete arr

    return destroyed
}
