module main

fun double_it(i32 x) -> i32 {
    return x * 2
}

fun add(i32 a, i32 b) -> i32 {
    return a + b
}

struct Point {
    i32 x,
    i32 y
}

fun magnitude_sq(Point p) -> i32 {
    return p.x * p.x + p.y * p.y
}

fun main() -> i32 {
    i32 n = 5
    // (5 * 2) + 2 = 12
    i32 res = n.double_it().add(2)

    Point pt = Point{ x: 3, y: 4 }
    // 3^2 + 4^2 = 25
    i32 mag = pt.magnitude_sq()

    // 12 + 25 = 37
    if res == 12 && mag == 25 {
        return 42
    }
    return 1
}
