// Insty standard library: net::dial
//
// Clean, high-level networking. Import this module in user code; the raw
// syscall layer in net::tcp / net::udp is the backend.
//
//     import net::dial
//
//     // client
//     dial.TcpStream c = dial.tcpConnect("127.0.0.1", 8080)
//     c.writeLine("hello")
//     c.close()
//
//     // server
//     dial.TcpListener srv = dial.tcpListen("0.0.0.0", 8080)
//     dial.TcpStream client = srv.accept()
//     client.writeLine("200 ok")
//     srv.close()
//
// Linux only for now (raw syscalls); wasm/Windows return error values
// until their socket backends land.

module dial

import std::str
import std::string
import std::vec
import net::tcp
import net::udp

// ---------------------------------------------------------------------------
// IPv4 address parsing
// ---------------------------------------------------------------------------

export fun parseIpv4(text s) -> u32 {
    u8[4] octets
    i64 dot = 0
    i64 start = 0
    i64 i = 0
    while i < 4 {
        while start < str.len(s) && (str.byte_at(s, start) == cast<u8>(' ') || str.byte_at(s, start) == cast<u8>('.')) {
            start = start + 1
        }
        i64 end = start
        while end < str.len(s) && str.is_digit(str.byte_at(s, end)) {
            end = end + 1
        }
        if end == start { return 0 }
        i64 value = 0
        i64 pos = start
        while pos < end {
            value = value * 10 + cast<i64>(str.byte_at(s, pos)) - 48
            pos = pos + 1
        }
        if value > 255 { return 0 }
        octets[i] = cast<u8>(value)
        start = end
        i = i + 1
    }
    return tcp.ipv4(octets[0], octets[1], octets[2], octets[3])
}

// ---------------------------------------------------------------------------
// TcpStream — connected TCP client or accepted connection
// ---------------------------------------------------------------------------

export class TcpStream {
    i64 fd
    text remote

    constructor(i64 _fd, text _remote) {
        this.fd = _fd
        this.remote = _remote
    }

    fun isOpen() -> bool {
        return this.fd >= 0
    }

    fun read(u8* buf, i64 max) -> i64 {
        if !this.isOpen() { return -1 }
        return tcp.read(this.fd, buf, max)
    }

    fun readAll() -> String {
        String out = String()
        if !this.isOpen() { return out }
        u8[4096] buf
        while true {
            unsafe {
                i64 n = tcp.read(this.fd, cast<u8*>(&buf), 4096)
                if n <= 0 { break }
                out.append_bytes(cast<u8*>(&buf), n)
            }
        }
        return out
    }

    fun readUntil(u8 delim) -> String {
        String out = String()
        if !this.isOpen() { return out }
        while true {
            u8 b = 0
            unsafe {
                i64 n = tcp.read(this.fd, &b, 1)
                if n <= 0 { break }
            }
            out.push(b)
            if b == delim { break }
        }
        return out
    }

    fun readLine() -> String {
        return this.readUntil(cast<u8>('\n'))
    }

    fun writeBytes(u8* buf, i64 count) -> i64 {
        if !this.isOpen() { return -1 }
        return tcp.write(this.fd, buf, count)
    }

    fun writeString(text s) -> bool {
        if !this.isOpen() { return false }
        return tcp.writeText(this.fd, s)
    }

    fun writeLine(text s) -> bool {
        if !this.isOpen() { return false }
        return tcp.writeText(this.fd, s) && tcp.writeText(this.fd, "\r\n")
    }

    fun writeInt(i64 value) -> bool {
        if !this.isOpen() { return false }
        if value < 0 {
            if !tcp.writeText(this.fd, "-") { return false }
            value = 0 - value
        }
        u8[32] buf
        i64 pos = 31
        if value == 0 {
            unsafe {
                buf[31] = cast<u8>('0')
                return tcp.writeAll(this.fd, cast<u8*>(&buf) + 31, 1)
            }
        }
        unsafe {
            while value > 0 && pos >= 0 {
                buf[pos] = cast<u8>('0') + cast<u8>(value % 10)
                value = value / 10
                pos = pos - 1
            }
            return tcp.writeAll(this.fd, cast<u8*>(&buf) + pos + 1, 31 - pos)
        }
    }

    fun close() -> void {
        if this.isOpen() {
            tcp.close(this.fd)
            this.fd = -1
        }
    }

    destructor() -> void {
        this.close()
    }
}

// ---------------------------------------------------------------------------
// TcpListener — bound TCP server
// ---------------------------------------------------------------------------

export class TcpListener {
    i64 fd

    constructor(i64 _fd) {
        this.fd = _fd
    }

    fun isOpen() -> bool {
        return this.fd >= 0
    }

    fun accept() -> TcpStream {
        if !this.isOpen() { return TcpStream(-1, "") }
        i64 clientFd = tcp.accept(this.fd)
        if clientFd < 0 { return TcpStream(-1, "") }
        return TcpStream(clientFd, "")
    }

    fun close() -> void {
        if this.isOpen() {
            tcp.close(this.fd)
            this.fd = -1
        }
    }

    destructor() -> void {
        this.close()
    }
}

// ---------------------------------------------------------------------------
// UdpSocket — UDP endpoint
// ---------------------------------------------------------------------------

export class UdpSocket {
    i64 fd

    constructor(i64 _fd) {
        this.fd = _fd
    }

    fun isOpen() -> bool {
        return this.fd >= 0
    }

    fun sendTo(u32 addr, u16 port, text payload) -> i64 {
        if !this.isOpen() { return -1 }
        unsafe { return udp.sendToIpv4(this.fd, addr, port, cast<u8*>(payload), str.len(payload)) }
    }

    fun recv() -> String {
        String out = String()
        if !this.isOpen() { return out }
        u8[2048] buf
        unsafe {
            i64 n = udp.recv(this.fd, cast<u8*>(&buf), 2048)
            if n > 0 { out.append_bytes(cast<u8*>(&buf), n) }
        }
        return out
    }

    fun close() -> void {
        if this.isOpen() {
            udp.close(this.fd)
            this.fd = -1
        }
    }

    destructor() -> void {
        this.close()
    }
}

// ---------------------------------------------------------------------------
// Convenience constructors
// ---------------------------------------------------------------------------

export fun ipv4(text a) -> u32 {
    return parseIpv4(a)
}

export fun tcpConnect(text addr, u16 port) -> TcpStream {
    u32 ip = parseIpv4(addr)
    if ip == 0 { return TcpStream(-1, "") }
    i64 fd = tcp.connectIpv4(ip, port)
    if fd < 0 { return TcpStream(-1, "") }
    return TcpStream(fd, addr)
}

export fun tcpListen(text addr, u16 port) -> TcpListener {
    u32 ip = parseIpv4(addr)
    if ip == 0 { return TcpListener(-1) }
    i64 fd = tcp.listenIpv4(ip, port, 16)
    if fd < 0 { return TcpListener(-1) }
    return TcpListener(fd)
}

export fun udpBind(text addr, u16 port) -> UdpSocket {
    i64 fd = udp.open()
    if fd < 0 { return UdpSocket(-1) }
    u32 ip = parseIpv4(addr)
    if ip == 0 {
        udp.close(fd)
        return UdpSocket(-1)
    }
    i64 rc = udp.bindIpv4(fd, ip, port)
    if rc < 0 {
        udp.close(fd)
        return UdpSocket(-1)
    }
    return UdpSocket(fd)
}
