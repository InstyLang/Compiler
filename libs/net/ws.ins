// Insty standard library: net::ws
//
// WebSocket requires SHA-1 + base64 for the HTTP upgrade handshake and frame
// masking/unmasking. The socket foundation is present, but the pure Insty
// crypto/encoding pieces are not yet in stdlib.

module ws

export fun errNotImplemented() -> i64 { return 0 - 38 }

export fun clientConnectIpv4(u32 addr, u16 port, text host, text path) -> i64 {
    return errNotImplemented()
}

export fun serverAccept(i64 tcpClient) -> i64 {
    return errNotImplemented()
}
