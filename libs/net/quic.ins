// Insty standard library: net::quic
//
// QUIC is not a thin UDP wrapper: it includes packet protection, TLS 1.3
// handshake integration, transport parameters, streams, ACK/loss recovery,
// congestion control, version negotiation, connection IDs, and timers. This
// module is a placeholder until those pure Insty layers exist.

module quic

export fun err_not_implemented() -> i64 { return 0 - 38 }

export fun connect_ipv4(u32 addr, u16 port, text server_name) -> i64 {
    return err_not_implemented()
}

export fun listen_ipv4(u32 addr, u16 port) -> i64 {
    return err_not_implemented()
}
