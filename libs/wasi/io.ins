// Insty standard library: wasi::io
//
// Console input and output for the wasm32_wasi target, built on the WASI
// preview1 fd_write / fd_read imports. No libc: bytes go straight to the host
// through a scatter/gather descriptor.
//
// This is the wasm counterpart of windows::io and instantos::io. std::io targets
// hosted Linux specifically (it issues raw syscalls), so wasm programs use this
// module instead.
//
// Usage:
//     import wasi::io
//
//     fun main() -> i32 {
//         wasi.println("hello from wasm")
//         wasi.println_int(42)
//         return 0
//     }

module wasi

import std::str

import wasi::sys

// Write `len` bytes at `ptr` to `fd`. Returns the number of bytes written, or a
// negative value if the host reported an error.
//
// fd_write takes an array of Ciovec records rather than a bare pointer, so one is
// built on the stack for the single buffer.
export fun write_bytes(i32 fd, u8* ptr, i64 len) -> i64 {
    unsafe {
        Ciovec iov
        iov.buf = cast<u32>(cast<u64>(ptr))
        iov.buf_len = cast<u32>(len)
        u32 written = 0
        i32 rc = fd_write(fd, cast<u8*>(&iov), 1, &written)
        if rc != 0 {
            return 0 - cast<i64>(rc)
        }
        return cast<i64>(written)
    }
    return 0
}

// Write a NUL-terminated string to stdout, no trailing newline.
export fun print(text s) -> void {
    unsafe {
        write_bytes(1, cast<u8*>(s), cast<i64>(str.len(s)))
    }
}

// Write a NUL-terminated string to stdout followed by a newline.
export fun println(text s) -> void {
    print(s)
    print("\n")
}

// Write a NUL-terminated string to stderr, no trailing newline.
export fun eprint(text s) -> void {
    unsafe {
        write_bytes(2, cast<u8*>(s), cast<i64>(str.len(s)))
    }
}

// Write a NUL-terminated string to stderr followed by a newline.
export fun eprintln(text s) -> void {
    eprint(s)
    eprint("\n")
}

// Write a signed integer in decimal to `fd`. Digits are built back to front in a
// stack buffer, so no allocation is involved.
export fun write_int(i32 fd, i64 n) -> void {
    unsafe {
        u8[32] buf
        u8* p = cast<u8*>(&buf)
        i64 i = 31
        i64 v = n
        bool neg = false
        if v < 0 {
            neg = true
            v = 0 - v
        }
        if v == 0 {
            p[i] = 48
            i = i - 1
        }
        while v > 0 {
            p[i] = cast<u8>(48 + (v - (v / 10) * 10))
            v = v / 10
            i = i - 1
        }
        if neg {
            p[i] = 45
            i = i - 1
        }
        i64 start = i + 1
        write_bytes(fd, cast<u8*>(cast<u64>(p) + cast<u64>(start)), 32 - start)
    }
}

// Write a signed integer in decimal to stdout, no trailing newline.
export fun print_int(i64 n) -> void {
    write_int(1, n)
}

// Write a signed integer in decimal to stdout followed by a newline.
export fun println_int(i64 n) -> void {
    write_int(1, n)
    print("\n")
}

// Write a signed integer in decimal to stderr followed by a newline.
export fun eprintln_int(i64 n) -> void {
    write_int(2, n)
    eprint("\n")
}

// Read up to `len` bytes from stdin into `buffer`. Returns the number of bytes
// read (0 at end of file), or a negative value on error.
export fun read_stdin(u8* buffer, i64 len) -> i64 {
    unsafe {
        Ciovec iov
        iov.buf = cast<u32>(cast<u64>(buffer))
        iov.buf_len = cast<u32>(len)
        u32 got = 0
        i32 rc = fd_read(0, cast<u8*>(&iov), 1, &got)
        if rc != 0 {
            return 0 - cast<i64>(rc)
        }
        return cast<i64>(got)
    }
    return 0
}

