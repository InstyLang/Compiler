// Insty standard library: wasi::sys
//
// Raw WASI preview1 system interface for the wasm32_wasi target. Each function
// below is a direct wasm import from the "wasi_snapshot_preview1" module, which
// the host (wasmtime, wasmer, a browser shim, ...) supplies. There is no libc in
// between.
//
// Every call returns an errno: 0 on success, otherwise one of the WASI error
// numbers. Results are delivered through out-pointers, as in the C ABI.
//
// Usage:
//     import wasi::sys
//
//     fun main() -> i32 {
//         if wasi.errno_success() == 0 { }
//         return 0
//     }
//
// Most programs want wasi::io instead, which wraps the console functions here in
// something ergonomic.

module wasi

// A scatter/gather buffer descriptor. On wasm32 both fields are 32-bit, so this
// is 8 bytes -- the layout fd_write and fd_read expect an array of.
export struct Ciovec {
    u32 buf,
    u32 buf_len
}

// --- file descriptors ------------------------------------------------------

// Write buffers to a descriptor. `iovs` points at `iovs_len` Ciovec records;
// the number of bytes actually written lands in `nwritten`.
export extern fun [dll("wasi_snapshot_preview1")] fd_write(
    i32 fd, u8* iovs, i32 iovs_len, u32* nwritten) -> i32

// Read into buffers from a descriptor. Returns 0 bytes read at end of file.
export extern fun [dll("wasi_snapshot_preview1")] fd_read(
    i32 fd, u8* iovs, i32 iovs_len, u32* nread) -> i32

export extern fun [dll("wasi_snapshot_preview1")] fd_close(i32 fd) -> i32

// Reposition a descriptor. `whence` is 0 = set, 1 = current, 2 = end.
export extern fun [dll("wasi_snapshot_preview1")] fd_seek(
    i32 fd, i64 offset, i32 whence, u64* newoffset) -> i32

// Flush a descriptor's buffers to their backing store.
export extern fun [dll("wasi_snapshot_preview1")] fd_sync(i32 fd) -> i32

// --- process --------------------------------------------------------------

// Terminate immediately with the given status. Never returns. Note that a WASI
// host only accepts a status in [0, 126).
export extern fun [dll("wasi_snapshot_preview1")] proc_exit(i32 code) -> void

export extern fun [dll("wasi_snapshot_preview1")] sched_yield() -> i32

// --- environment ----------------------------------------------------------

export extern fun [dll("wasi_snapshot_preview1")] args_sizes_get(
    u32* argc, u32* argv_buf_size) -> i32

export extern fun [dll("wasi_snapshot_preview1")] environ_sizes_get(
    u32* count, u32* buf_size) -> i32

// --- entropy and clocks ---------------------------------------------------

// Fill a buffer with cryptographically random bytes.
export extern fun [dll("wasi_snapshot_preview1")] random_get(
    u8* buf, i32 buf_len) -> i32

// Read a clock. `id` is 0 = realtime, 1 = monotonic. The result is nanoseconds.
export extern fun [dll("wasi_snapshot_preview1")] clock_time_get(
    i32 id, u64 precision, u64* time) -> i32

// --- descriptor numbers and constants -------------------------------------
//
// Module-level globals are not visible across an `import`, so these are exposed
// as zero-argument accessors -- the same convention windows::* uses for its
// Win32 constants.

export fun stdin_fd() -> i32 { return 0 }
export fun stdout_fd() -> i32 { return 1 }
export fun stderr_fd() -> i32 { return 2 }

export fun errno_success() -> i32 { return 0 }
export fun errno_badf() -> i32 { return 8 }
export fun errno_inval() -> i32 { return 28 }

export fun clock_realtime() -> i32 { return 0 }
export fun clock_monotonic() -> i32 { return 1 }

export fun whence_set() -> i32 { return 0 }
export fun whence_cur() -> i32 { return 1 }
export fun whence_end() -> i32 { return 2 }

// --- opening files by path ------------------------------------------------

// Open a file relative to a directory descriptor. Nine arguments, three of them
// past the argument registers, so this needs the backend's stack-argument path.
//
// `fd` is a preopened directory (the host grants these; the first is normally 3).
// The opened descriptor is written to `opened_fd`.
export extern fun [dll("wasi_snapshot_preview1")] path_open(
    i32 fd,
    i32 dirflags,
    u8* path,
    i32 path_len,
    i32 oflags,
    u64 fs_rights_base,
    u64 fs_rights_inheriting,
    i32 fdflags,
    i32* opened_fd) -> i32

// Remove a file relative to a directory descriptor.
export extern fun [dll("wasi_snapshot_preview1")] path_unlink_file(
    i32 fd, u8* path, i32 path_len) -> i32

// Query a preopened descriptor's kind and name length.
export extern fun [dll("wasi_snapshot_preview1")] fd_prestat_get(
    i32 fd, u8* buf) -> i32

// The first descriptor a host preopens. 0-2 are the standard streams.
export fun first_preopen_fd() -> i32 { return 3 }

// path_open oflags.
export fun oflag_creat() -> i32 { return 1 }
export fun oflag_directory() -> i32 { return 2 }
export fun oflag_excl() -> i32 { return 4 }
export fun oflag_trunc() -> i32 { return 8 }

// A broad set of file rights. The host rejects anything the preopen does not
// itself hold, so a directory granted with a plain --dir covers these.
export fun rights_file() -> u64 { return 0x0FFFFFFF }
