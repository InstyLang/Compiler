// Insty standard library: math
//
// Integer math helpers. All functions operate on i64; callers with smaller
// integer types are implicitly widened at the call site.

module math

// Absolute value.
export fun abs(i64 n) -> i64 {
    if n < 0 {
        return 0 - n
    }
    return n
}

// Smaller of two values.
export fun min(i64 a, i64 b) -> i64 {
    if a < b {
        return a
    }
    return b
}

// Larger of two values.
export fun max(i64 a, i64 b) -> i64 {
    if a > b {
        return a
    }
    return b
}

// Clamp v into the inclusive range [lo, hi].
export fun clamp(i64 v, i64 lo, i64 hi) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// -1, 0, or 1 depending on the sign of n.
export fun sign(i64 n) -> i64 {
    if n < 0 {
        return 0 - 1
    }
    if n > 0 {
        return 1
    }
    return 0
}

// Absolute distance between two signed values, returned as an unsigned value.
export fun abs_diff(i64 a, i64 b) -> u64 {
    if a >= b {
        return cast<u64>(a - b)
    }
    return cast<u64>(b - a)
}

// True when n is divisible by 2.
export fun is_even(i64 n) -> bool {
    return (n - (n / 2) * 2) == 0
}

// True when n is not divisible by 2.
export fun is_odd(i64 n) -> bool {
    return !is_even(n)
}

// n modulo m with a non-negative result when m is positive.
export fun mod(i64 n, i64 m) -> i64 {
    if m == 0 {
        return 0
    }
    i64 r = n - (n / m) * m
    if r < 0 {
        if m < 0 {
            return r - m
        }
        return r + m
    }
    return r
}

// Integer floor division for positive or negative values. Division by 0 yields 0.
export fun div_floor(i64 n, i64 d) -> i64 {
    if d == 0 {
        return 0
    }
    i64 q = n / d
    i64 r = n - q * d
    if r != 0 {
        if (r < 0 && d > 0) || (r > 0 && d < 0) {
            return q - 1
        }
    }
    return q
}

// Round v up to the next multiple of align. align <= 0 returns v unchanged.
export fun align_up(i64 v, i64 align) -> i64 {
    if align <= 0 {
        return v
    }
    i64 r = mod(v, align)
    if r == 0 {
        return v
    }
    return v + align - r
}

// Round v down to a multiple of align. align <= 0 returns v unchanged.
export fun align_down(i64 v, i64 align) -> i64 {
    if align <= 0 {
        return v
    }
    return v - mod(v, align)
}

// Greatest common divisor. The result is always non-negative.
export fun gcd(i64 a, i64 b) -> i64 {
    i64 x = abs(a)
    i64 y = abs(b)
    while y != 0 {
        i64 r = x - (x / y) * y
        x = y
        y = r
    }
    return x
}

// Least common multiple. Returns 0 if either input is 0.
export fun lcm(i64 a, i64 b) -> i64 {
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }
    i64 g = gcd(a, b)
    i64 r = (a / g) * b
    return abs(r)
}

// Factorial for n >= 0. Negative inputs yield 0.
export fun factorial(i64 n) -> i64 {
    if n < 0 {
        return 0
    }
    i64 result = 1
    i64 i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

// base raised to the exp power (exp < 0 yields 0, integer semantics).
export fun pow(i64 base, i64 exp) -> i64 {
    if exp < 0 {
        return 0
    }
    i64 result = 1
    i64 b = base
    i64 e = exp
    while e > 0 {
        if (e - (e / 2) * 2) == 1 {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    return result
}
