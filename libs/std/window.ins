// Insty standard library: std::window
//
// Cross-platform native windowing with a sum-type event model.
//
//     import std::window
//
//     fun onEvent(window.WindowEvent e) -> void {
//         switch e {
//             window.Close => { }
//             window.KeyDown(code) => { }
//             window.Resize(w, h) => { }
//             _ => {}
//         }
//     }
//
//     fun main() -> i32 {
//         window.Window w = window.open("Hello", 800, 600)
//         w.on(&onEvent)
//         w.start()
//         w.blockExit()
//     }
//
// Linux: Xlib (links libX11 automatically). Windows: Win32 user32.dll.

module window

import std::vec
import std::str

// ---------------------------------------------------------------------------
// Dimensions
// ---------------------------------------------------------------------------

export struct Dim {
    i32 w,
    i32 h
}

// ---------------------------------------------------------------------------
// Event
// ---------------------------------------------------------------------------

export enum WindowEvent {
    Close,
    KeyDown(i32),
    KeyUp(i32),
    MouseDown(i32, i32),
    MouseUp(i32, i32),
    MouseMove(i32, i32),
    Resize(i32, i32),
    Paint
}

// ---------------------------------------------------------------------------
// Window
// ---------------------------------------------------------------------------

export class Window {
    // Platform handles and the user-registered callback.
    u64 platformHandle
    u64 platformHandle2
    u64 eventCallback

    constructor() {
        this.platformHandle = 0
        this.platformHandle2 = 0
        this.eventCallback = 0
    }

    fun isValid() -> bool {
        return this.platformHandle != 0
    }

    fun on(u64 cb) -> void {
        this.eventCallback = cb
    }

    fun close() -> void {
        windowClosePtr(this)
    }

    fun setTitle(text title) -> void {
        windowSetTitlePtr(this, title)
    }

    // Pumps events until the window is closed. Calls the registered callback for
    // each event, then returns when the platform signals an exit.
    fun start() -> void {
        windowStartPtr(this)
    }

    // Blocks the calling thread at a join point so the program doesn't exit
    // before the event loop finishes. On most platforms start() already blocks;
    // this is a no-op unless a platform's event loop runs asynchronously.
    fun blockExit() -> void {
    }
}

// =========================================================================
// Platform: Linux / X11
// =========================================================================

#if @targetIs("linux") {

import unix::x11
extern fun [lib("X11")] XInternAtom(u64 display, text name, i32 onlyIfExists) -> u64
extern fun [lib("X11")] XSetWMProtocols(u64 display, u64 window, u64* protocols, i32 count) -> i32

export fun open(text title, i32 width, i32 height) -> Window {
    u64 dpy = x11.open_display("")
    if dpy == 0 { return Window() }
    i32 screen = x11.default_screen(dpy)
    u64 root = x11.root_window(dpy, screen)
    u32 w = cast<u32>(width)
    u32 h = cast<u32>(height)
    u64 win = x11.create_simple_window(dpy, root, 0, 0, w, h, 1,
        x11.black_pixel(dpy, screen), x11.white_pixel(dpy, screen))
    if win == 0 {
        x11.close_display(dpy)
        return Window()
    }
    x11.store_name(dpy, win, title)
    i64 mask = x11.key_press_mask()
    mask = mask | x11.key_release_mask()
    mask = mask | x11.button_press_mask()
    mask = mask | x11.button_release_mask()
    mask = mask | x11.pointer_motion_mask()
    mask = mask | x11.exposure_mask()
    mask = mask | x11.structure_notify_mask()
    x11.select_input(dpy, win, mask)
    x11.map_window(dpy, win)
    x11.flush(dpy)

    unsafe {
        u64 wmDelete = XInternAtom(dpy, "WM_DELETE_WINDOW", 0)
        u64 wmProto = XInternAtom(dpy, "WM_PROTOCOLS", 0)
        XSetWMProtocols(dpy, win, &wmDelete, 1)
    }

    Window out
    out.platformHandle = dpy
    out.platformHandle2 = win
    out.eventCallback = 0
    return out
}

fun windowClosePtr(Window* w) -> void {
    if !w.isValid() { return }
    x11.destroy_window(w.platformHandle, w.platformHandle2)
    x11.close_display(w.platformHandle)
    w.platformHandle = 0
    w.platformHandle2 = 0
}

fun windowSetTitlePtr(Window* w, text title) -> void {
    if !w.isValid() { return }
    x11.store_name(w.platformHandle, w.platformHandle2, title)
    x11.flush(w.platformHandle)
}

fun windowStartPtr(Window* w) -> void {
    if !w.isValid() { return }
    while true {
        u8[192] buf
        unsafe { x11.next_event(w.platformHandle, cast<u8*>(&buf)) }
        i32 kind = 0
        unsafe { kind = x11.event_type(cast<u8*>(&buf)) }

        WindowEvent ev = WindowEvent.Close
        bool haveEvent = false

        if kind == x11.key_press() {
            ev = WindowEvent.KeyDown(0)
            haveEvent = true
        } else if kind == x11.key_release() {
            ev = WindowEvent.KeyUp(0)
            haveEvent = true
        } else if kind == x11.button_press() {
            ev = WindowEvent.MouseDown(0, 0)
            haveEvent = true
        } else if kind == x11.button_release() {
            ev = WindowEvent.MouseUp(0, 0)
            haveEvent = true
        } else if kind == x11.motion_notify() {
            ev = WindowEvent.MouseMove(0, 0)
            haveEvent = true
        } else if kind == x11.expose() {
            ev = WindowEvent.Paint
            haveEvent = true
        } else if kind == x11.client_message() {
            ev = WindowEvent.Close
            haveEvent = true
        } else if kind == 22 {
            ev = WindowEvent.Resize(0, 0)
            haveEvent = true
        }

        if haveEvent && w.eventCallback != 0 {
            unsafe { fnCall<void>(w.eventCallback, ev) }
        }
        if haveEvent {
            switch ev {
                Close => { w.close(); return }
                _ => {}
            }
        }
    }
}

} // #if linux

// =========================================================================
// Platform: Windows
// =========================================================================

#if @targetIs("windows") {

import windows::window as win32

Vector<WindowEvent> eventQueue

// The internal WNDPROC. Decodes common messages into WindowEvent values and
// pushes them onto the module-level queue. The registered user callback is
// NOT called from here (WNDPROCs must be fast); start() drains the queue.
fun [mangle(off), name("InstyWndProc")] wndProc(u64 hwnd, u32 msg, u64 wParam, i64 lParam) -> i64 {
    if msg == win32.wm_close() || msg == win32.wm_destroy() {
        eventQueue.push(WindowEvent.Close)
        if msg == win32.wm_destroy() { win32.post_quit(0) }
        return 0
    }
    if msg == win32.wm_keydown() {
        eventQueue.push(WindowEvent.KeyDown(cast<i32>(wParam)))
        return 0
    }
    if msg == win32.wm_keyup() {
        eventQueue.push(WindowEvent.KeyUp(cast<i32>(wParam)))
        return 0
    }
    if msg == win32.wm_lbuttondown() {
        i32 mx = cast<i32>(lParam & 0xFFFF)
        i32 my = cast<i32>((cast<u64>(lParam) >> 16) & 0xFFFF)
        eventQueue.push(WindowEvent.MouseDown(mx, my))
        return 0
    }
    if msg == win32.wm_size() {
        i32 nw = cast<i32>(lParam & 0xFFFF)
        i32 nh = cast<i32>((cast<u64>(lParam) >> 16) & 0xFFFF)
        eventQueue.push(WindowEvent.Resize(nw, nh))
        return 0
    }
    if msg == win32.wm_paint() {
        eventQueue.push(WindowEvent.Paint)
    }
    return win32.def_window_proc(hwnd, msg, wParam, lParam)
}

export fun open(text title, i32 width, i32 height) -> Window {
    u64 inst = win32.instance_handle()
    u64 proc = 0
    unsafe { proc = cast<u64>(&wndProc) }
    win32.register_class("InstyWndClass", proc, inst)
    u64 hwnd = win32.create_window("InstyWndClass", title, width, height, inst)
    if hwnd == 0 { return Window() }
    win32.show_default(hwnd)
    win32.update(hwnd)
    Window out
    out.platformHandle = hwnd
    out.platformHandle2 = 0
    out.eventCallback = 0
    return out
}

fun windowClosePtr(Window* w) -> void {
    if !w.isValid() { return }
    win32.destroy_window(w.platformHandle)
    w.platformHandle = 0
}

fun windowSetTitlePtr(Window* w, text title) -> void {
}

fun windowStartPtr(Window* w) -> void {
    if !w.isValid() { return }
    u8[48] msgBuf
    while true {
        // Drain queued events first.
        while eventQueue.len() > 0 {
            WindowEvent ev = eventQueue.get(0)
            eventQueue.pop()
            if w.eventCallback != 0 {
                unsafe { fnCall<void>(w.eventCallback, ev) }
            }
            switch ev {
                Close => { w.close(); return }
                _ => {}
            }
        }
        i32 got = 0
        unsafe { got = win32.get_message(cast<u8*>(&msgBuf), 0) }
        if got == 0 {
            if w.eventCallback != 0 {
                unsafe { fnCall<void>(w.eventCallback, WindowEvent.Close) }
            }
            w.close()
            return
        }
        if got < 0 { return }
        unsafe {
            win32.translate_message(cast<u8*>(&msgBuf))
            win32.dispatch_message(cast<u8*>(&msgBuf))
        }
    }
}

eventQueue = Vector<WindowEvent>()

} // #if windows

// =========================================================================
// Fallback (wasm, macOS, freestanding)
// =========================================================================

#if !@targetIs("linux") && !@targetIs("windows") {

export fun open(text title, i32 width, i32 height) -> Window {
    return Window()
}

fun windowClosePtr(Window* w) -> void {
}

fun windowSetTitlePtr(Window* w, text title) -> void {
}

fun windowStartPtr(Window* w) -> void {
}

} // #if fallback
