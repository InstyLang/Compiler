// Insty standard library: parse
//
// Allocation-free parsers for NUL-terminated text. The *_at functions skip
// leading ASCII whitespace, parse from the supplied byte index, and return the
// index immediately after the parsed value.

module parse

export struct U64Result {
    bool ok
    u64 value
    i64 end
}

export struct I64Result {
    bool ok
    i64 value
    i64 end
}

export struct BoolResult {
    bool ok
    bool value
    i64 end
}

fun u64_result(bool ok, u64 value, i64 end) -> U64Result {
    U64Result r
    r.ok = ok
    r.value = value
    r.end = end
    return r
}

fun i64_result(bool ok, i64 value, i64 end) -> I64Result {
    I64Result r
    r.ok = ok
    r.value = value
    r.end = end
    return r
}

fun bool_result(bool ok, bool value, i64 end) -> BoolResult {
    BoolResult r
    r.ok = ok
    r.value = value
    r.end = end
    return r
}

fun is_space_byte(u8 b) -> bool {
    if b == 32 {
        return true
    }
    return b >= 9 && b <= 13
}

fun digit_value(u8 b) -> i64 {
    if b >= 48 && b <= 57 {
        return cast<i64>(b - 48)
    }
    if b >= 65 && b <= 90 {
        return cast<i64>(b - 55)
    }
    if b >= 97 && b <= 122 {
        return cast<i64>(b - 87)
    }
    return 0 - 1
}

export fun skip_spaces(text s, i64 start) -> i64 {
    unsafe {
        u8* p = cast<u8*>(s)
        i64 i = start
        if i < 0 {
            i = 0
        }
        while is_space_byte(p[i]) {
            i = i + 1
        }
        return i
    }
    return start
}

// Parse an unsigned integer in base 2..16. base 0 infers decimal, or hex for
// a 0x/0X prefix. On overflow, ok is false and end points at the offending digit.
export fun u64_at(text s, i64 start, i64 base) -> U64Result {
    unsafe {
        u8* p = cast<u8*>(s)
        i64 i = skip_spaces(s, start)
        i64 b = base
        if b == 0 {
            b = 10
            if p[i] == 48 {
                if p[i + 1] == 120 || p[i + 1] == 88 {
                    b = 16
                    i = i + 2
                }
            }
        }
        if b < 2 || b > 16 {
            return u64_result(false, 0, i)
        }

        u64 value = 0
        u64 ub = cast<u64>(b)
        u64 max = cast<u64>(0 - 1)
        bool any = false
        while true {
            i64 d = digit_value(p[i])
            if d < 0 || d >= b {
                break
            }
            u64 ud = cast<u64>(d)
            if value > (max - ud) / ub {
                return u64_result(false, value, i)
            }
            value = value * ub + ud
            any = true
            i = i + 1
        }
        if !any {
            return u64_result(false, 0, i)
        }
        return u64_result(true, value, i)
    }
    return u64_result(false, 0, start)
}

// Parse a signed integer in base 2..16. base 0 follows u64_at inference.
export fun i64_at(text s, i64 start, i64 base) -> I64Result {
    unsafe {
        u8* p = cast<u8*>(s)
        i64 i = skip_spaces(s, start)
        bool neg = false
        if p[i] == 45 {
            neg = true
            i = i + 1
        } else if p[i] == 43 {
            i = i + 1
        }

        U64Result u = u64_at(s, i, base)
        if !u.ok {
            return i64_result(false, 0, u.end)
        }
        u64 limit = cast<u64>(9223372036854775807)
        if u.value > limit {
            return i64_result(false, 0, u.end)
        }
        i64 v = cast<i64>(u.value)
        if neg {
            v = 0 - v
        }
        return i64_result(true, v, u.end)
    }
    return i64_result(false, 0, start)
}

// Parse true/false.
export fun bool_at(text s, i64 start) -> BoolResult {
    unsafe {
        u8* p = cast<u8*>(s)
        i64 i = skip_spaces(s, start)
        if p[i] == 116 && p[i + 1] == 114 && p[i + 2] == 117 && p[i + 3] == 101 {
            return bool_result(true, true, i + 4)
        }
        if p[i] == 102 && p[i + 1] == 97 && p[i + 2] == 108 && p[i + 3] == 115 && p[i + 4] == 101 {
            return bool_result(true, false, i + 5)
        }
        return bool_result(false, false, i)
    }
    return bool_result(false, false, start)
}

export fun u64(text s) -> u64 {
    U64Result r = u64_at(s, 0, 10)
    return r.value
}

export fun i64(text s) -> i64 {
    I64Result r = i64_at(s, 0, 10)
    return r.value
}

export fun bool(text s) -> bool {
    BoolResult r = bool_at(s, 0)
    return r.value
}
