// Insty standard library: string
//
// A growable, owned UTF-8/byte string builder. Backed by a heap `u8[]` that
// doubles on demand; always keeps room for a trailing NUL so `cstr()` can hand
// back a `text` without copying.
//
// Requires a heap allocator (`--allocator runtime` or `external`).

module string

import std::str

export class String {
    u8[] data      // backing store; data.len is the capacity (>= count + 1)
    i64 count      // number of live bytes (excluding the trailing NUL)

    constructor() {
        this.data = new u8[8]
        this.count = 0
        this.data[0] = 0
    }

    // Number of bytes currently held (excluding the terminator).
    fun len() -> i64 {
        return this.count
    }

    fun is_empty() -> bool {
        return this.count == 0
    }

    // Byte at `index` (0 when out of range).
    fun byte_at(i64 index) -> u8 {
        if index < 0 {
            return 0
        }
        if index >= this.count {
            return 0
        }
        return this.data[index]
    }

    // Ensure capacity for at least `needed` bytes plus the NUL terminator.
    fun reserve(i64 needed) -> void {
        i64 want = needed + 1
        if this.data.len >= want {
            return
        }
        i64 newCap = this.data.len * 2
        while newCap < want {
            newCap = newCap * 2
        }
        u8[] bigger = new u8[newCap]
        i64 i = 0
        while i < this.count {
            bigger[i] = this.data[i]
            i = i + 1
        }
        delete this.data.ptr
        this.data = bigger
    }

    // Append a single byte.
    fun push(u8 b) -> void {
        this.reserve(this.count + 1)
        this.data[this.count] = b
        this.count = this.count + 1
        this.data[this.count] = 0
    }

    // Append a NUL-terminated `text`.
    fun append(text s) -> void {
        i64 n = str.len(s)
        this.reserve(this.count + n)
        i64 i = 0
        while i < n {
            this.data[this.count + i] = str.byte_at(s, i)
            i = i + 1
        }
        this.count = this.count + n
        this.data[this.count] = 0
    }

    // Append the decimal form of a signed integer.
    fun append_int(i64 value) -> void {
        if value == 0 {
            this.push(48)          // '0'
            return
        }
        bool neg = value < 0
        // Work in unsigned magnitude so i64 min does not overflow on negation.
        u64 mag = 0
        if neg {
            mag = cast<u64>(0 - value)
        } else {
            mag = cast<u64>(value)
        }
        u8[24] tmp
        i64 n = 0
        while mag > 0 {
            u64 digit = mag - (mag / 10) * 10
            tmp[n] = cast<u8>(48 + cast<i64>(digit))
            mag = mag / 10
            n = n + 1
        }
        if neg {
            this.push(45)          // '-'
        }
        // Digits were produced least-significant first; emit reversed.
        while n > 0 {
            n = n - 1
            this.push(tmp[n])
        }
    }

    // Append `n` raw bytes from `src` (e.g. a read(2) buffer).
    fun append_bytes(u8* src, i64 n) -> void {
        if n <= 0 {
            return
        }
        this.reserve(this.count + n)
        unsafe {
            i64 i = 0
            while i < n {
                this.data[this.count + i] = src[i]
                i = i + 1
            }
        }
        this.count = this.count + n
        this.data[this.count] = 0
    }

    // Append another String's bytes.
    fun append_string(String other) -> void {
        i64 n = other.len()
        this.reserve(this.count + n)
        i64 i = 0
        while i < n {
            this.data[this.count + i] = other.byte_at(i)
            i = i + 1
        }
        this.count = this.count + n
        this.data[this.count] = 0
    }

    // Reset to empty (keeps the capacity).
    fun clear() -> void {
        this.count = 0
        this.data[0] = 0
    }

    // A NUL-terminated view of the contents. Borrows the backing store; a later
    // append that grows the string invalidates it.
    fun cstr() -> text {
        unsafe {
            return cast<text>(this.data.ptr)
        }
    }

    // A byte-slice view of the live bytes [0, len) (excludes the NUL).
    fun as_bytes() -> u8[] {
        return this.data[0..this.count]
    }

    // Content equality against a NUL-terminated string.
    fun equals(text other) -> bool {
        return str.eq(this.cstr(), other)
    }

    fun starts_with(text prefix) -> bool {
        return str.starts_with(this.cstr(), prefix)
    }

    fun ends_with(text suffix) -> bool {
        return str.ends_with(this.cstr(), suffix)
    }

    fun contains(text needle) -> bool {
        return str.contains(this.cstr(), needle)
    }

    // Index of the first occurrence of `needle`, or -1.
    fun find(text needle) -> i64 {
        return str.find(this.cstr(), needle)
    }

    // FNV-1a hash of the contents (matches str.hash, so a String and an equal
    // `text` hash the same).
    fun hash() -> u64 {
        return str.hash(this.cstr())
    }

    // A fresh String holding the bytes in [start, end). Out-of-range bounds are
    // clamped to [0, len].
    fun substring(i64 start, i64 end) -> String {
        i64 lo = start
        i64 hi = end
        if lo < 0 {
            lo = 0
        }
        if hi > this.count {
            hi = this.count
        }
        String out = String()
        i64 i = lo
        while i < hi {
            out.push(this.data[i])
            i = i + 1
        }
        return out
    }

    destructor() -> void {
        delete this.data.ptr
    }
}
