enum Color {
  Red = 0
  Green = 1
  Blue = 2
}
enum Explicit {
  Off = 0
  On = 1
  Standby = 10
  Sleep = 11
}
enum Negative {
  ErrA = -3
  ErrB = -2
  Ok = 0
}
enum Trailing {
  One = 1
  Two = 2
}
enum Big {
  Huge = 4294967295
  Bigger = 4294967296
}
global favorite: enum Color
enum Speed {
  Fast = 0
  Slow = 1
}
typedef Speed = enum Speed
